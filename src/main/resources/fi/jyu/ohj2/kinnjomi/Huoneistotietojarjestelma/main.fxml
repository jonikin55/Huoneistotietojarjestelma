<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" minHeight="250.0" minWidth="500.0" prefHeight="500.0" prefWidth="500.0" spacing="20.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fi.jyu.ohj2.kinnjomi.Huoneistotietojarjestelma.controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <TableView fx:id="asuntoTiedotTable" prefHeight="506.0" prefWidth="460.0">
        <columns>
          <TableColumn prefWidth="112.0" text="Asunnon tunnus" />
          <TableColumn prefWidth="123.0" text="Asukkaiden maara" />
        </columns>
      </TableView>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Button fx:id="lisaaAsuntoButton" mnemonicParsing="false" text="Lisää asunto" />
            <Button fx:id="muokkaaButton" mnemonicParsing="false" text="Muokkaa" />
            <Button fx:id="poistaButton" mnemonicParsing="false" text="Poista" />
         </children>
      </HBox>
   </children>
</VBox>
